    },
    {
      "name": "08. HR & Directory",
      "item": [
        {
          "name": "List Employees Directory",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/directory/",
              "host": ["{{base_url}}"],
              "path": ["directory", ""]
            }
          }
        },
        {
          "name": "List HR Requests",
          "request": {
            "method": "GET",
